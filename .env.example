# =============================================================================
# FISCALIZACIÓN HSE — Variables de entorno (copiar a .env y ajustar)
# =============================================================================
# IMPORTANTE: No versionar .env (contiene secretos).
# Este archivo es solo plantilla.
#
# Puertos elegidos para NO chocar con desarrollo local habitual:
#   - PostgreSQL local sin Docker suele usar 5434 en este proyecto
#   - PostgreSQL estándar usa 5432
#   - Angular dev usa 4200
#   - Backend Spring usa 8080
# Docker local expone Postgres en 5435 y frontend en 8081 para evitar conflictos.
# =============================================================================

# --- Perfil Spring (docker | prod | local) ---
SPRING_PROFILES_ACTIVE=docker

# --- Puertos expuestos en el HOST ---
# Local (PC): ver conflictos con otros servicios antes de levantar Docker
POSTGRES_HOST_PORT=5436
BACKEND_HOST_PORT=8082
FRONTEND_HOST_PORT=8083

# Producción (VPS): alineado con improvement (8001), pollos (8004), agenda (4200/8081)
# FRONTEND_HOST_PORT=8005
# BACKEND_HOST_PORT=8090

# --- Base de datos ---
POSTGRES_DB=fiscalizacion_hse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_password_seguro

DB_HOST=postgres
DB_PORT=5432
DB_NAME=fiscalizacion_hse
DB_USER=postgres
DB_PASSWORD=cambiar_password_seguro

# --- Seguridad ---
JWT_SECRET=generar_un_secreto_base64_largo_y_unico

# --- Super Admin inicial ---
SUPER_ADMIN_EMAIL=admin@fiscalizacionhse.com
SUPER_ADMIN_PASSWORD=cambiar_password_admin

# --- CORS (orígenes separados por coma) ---
# Local Docker: incluye frontend en 8081 y Angular dev en 4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost:8081,http://localhost

# --- APIs externas (opcional) ---
DEEPSEEK_API_KEY=
GOOGLE_TTS_API_KEY=
DEEPSEEK_AUDIO_API_KEY=

# --- Producción (docker-compose.prod.yml) ---
FRONTEND_HOST_PORT=8005
BACKEND_HOST_PORT=8090
# CORS_ALLOWED_ORIGINS=https://hse.tu-dominio.com
