# =============================================================================
# VPS PRODUCCIÓN — Fiscalización HSE
# Copiar a .env en el servidor (NO versionar)
# =============================================================================

SPRING_PROFILES_ACTIVE=prod

# Puertos en el VPS (no chocan con otros programas — ver DEPLOY.md)
FRONTEND_HOST_PORT=8005
BACKEND_HOST_PORT=8090

# PostgreSQL interno Docker (no expone puerto al host)
POSTGRES_DB=fiscalizacion_hse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURO

DB_HOST=postgres
DB_PORT=5432
DB_NAME=fiscalizacion_hse
DB_USER=postgres
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO

JWT_SECRET=GENERAR_SECRETO_BASE64_LARGO_Y_UNICO
SUPER_ADMIN_EMAIL=admin@fiscalizacionhse.com
SUPER_ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN

# Dominio real cuando configure Nginx + SSL
CORS_ALLOWED_ORIGINS=https://hse.improvement-solution.com

DEEPSEEK_API_KEY=
GOOGLE_TTS_API_KEY=
DEEPSEEK_AUDIO_API_KEY=
